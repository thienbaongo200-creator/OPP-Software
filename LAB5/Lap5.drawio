        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam BoxPadding 10\nskinparam ParticipantPadding 10\n\nactor \&quot;: NV điều hành\&quot; as NV\nparticipant \&quot;: FrmTour\&quot; as Form\nparticipant \&quot;: TourService\&quot; as Svc\nparticipant \&quot;: Tour\&quot; as Tour\nparticipant \&quot;: DiemDung\&quot; as DD\n\nNV -&gt; Form: Mo form \&quot;Tour - hanh trinh\&quot;\nNV -&gt; Form: Nhap thong tin tour (ma, ten, so ngay, so dem, don gia, mo ta)\nNV -&gt; Form: Nhan \&quot;Them tour\&quot;\nForm -&gt; Svc: ThemTour(ma, ten, soNgay, soDem, donGia, moTa)\nSvc -&gt; Svc: Kiem tra du thong tin, so ngay &gt; 0, so dem &gt;= so ngay, don gia &gt;= 0\n\nalt du lieu khong hop le\n    Svc --&gt; Form: KetQuaXuLy.Fail(ly do)\nelse hop le\n    Svc -&gt; Tour: themTour(...)\n    Tour --&gt; Svc: Thanh cong\n    Svc --&gt; Form: KetQuaXuLy.Ok(\&quot;Da them tour.\&quot;)\nend\nForm --&gt; NV: Thong bao; tai lai danh sach tour\n\nNV -&gt; Form: Chon tour, nhap thong tin diem dung (thu tu, ten, doi PT, an, khach san, sao)\nNV -&gt; Form: Nhan \&quot;Them diem dung\&quot;\nForm -&gt; Svc: ThemDiemDung(maTour, thuTu, ten, doiPT, coAn, coKS, hangSao, ghiChu)\n\nalt coKS == true &amp;&amp; (hangSao &lt; 2 || hangSao &gt; 5)\n    Svc --&gt; Form: KetQuaXuLy.Fail(\&quot;Khach san phai co hang tu 2 den 5 sao.\&quot;)\nelse hop le\n    Svc -&gt; DD: themDiemDung(...)\n    DD --&gt; Svc: Thanh cong\n    Svc --&gt; Form: KetQuaXuLy.Ok(\&quot;Da them diem dung.\&quot;)\nend\nForm --&gt; NV: Thong bao; tai lai danh sach diem dung\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YNnl0qOu6NH3KYG2MC8i-1">
