        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n\n&#39; ================= LỚP TRỤ CỘT / TRUNG TÂM =================\nclass PhongBan {\n    + MaPhongBan\n    + TenPhongBan\n    + ...\n}\n\nclass NhanVien {\n    + MaNhanVien\n    + HoTen\n    + ...\n}\n\nclass TaiKhoan {\n    + MaTaiKhoan\n    + TenDangNhap\n    + MatKhauHash\n    + VaiTro\n    + MaNhanVien nullable\n    + TrangThai\n    --\n    + XacThuc()\n    + KiemTraQuyen()\n}\n\n&#39; ================= LỚP QUYẾT ĐỊNH &amp; HỢP ĐỒNG =================\nclass QuyetDinhTuyenDung {\n    + MaQuyetDinhTD\n    + MaNhanVien\n    + MaPhongBan\n    + NgayQuyetDinh\n    + NgayBatDauThuViec\n    + NgayKetThucThuViec\n    + LuongThuViec\n    + DieuKhoan\n    + NguoiKy\n    + TrangThaiDuyet\n    --\n    + GuiDuyet()\n    + PheDuyet()\n    + TuChoi()\n}\n\nclass HopDongLaoDong {\n    + MaHopDong\n    + MaNhanVien\n    + LoaiHopDong\n    + NgayBatDau\n    + NgayKetThuc\n    + LuongThoaThuan\n    + TrangThai\n    --\n    + KiemTraHieuLuc()\n    + GiaHan()\n    + KetThuc()\n}\n\nclass HoSoBaoHiem {\n    + MaHoSoBH\n    + MaNhanVien\n    + MaHopDong\n    + SoBHXH\n    + SoBHYT\n    + MucLuongDong\n    + NgayThamGia\n    + TrangThai\n    --\n    + KhoiTao()\n    + CapNhatThongTin()\n}\n\nclass QuyetDinhLuong {\n    + MaQuyetDinhLuong\n    + MaNhanVien\n    + NgayHieuLuc\n    + LuongCoBan\n    + PhuCapLuong\n    + PhuCapDocHai\n    + LyDo\n    + NguoiKy\n    + TrangThaiDuyet\n    + MaQuyetDinhThayThe nullable\n    --\n    + TinhLuongCoSo()\n    + PheDuyet()\n    + ThayThe()\n}\n\nclass QuyetDinhChucVu {\n    + MaQuyetDinhCV\n    + MaNhanVien\n    + ChucVu\n    + PhuCapChucVu\n    + NgayHieuLuc\n    + NguoiKy\n    + TrangThaiDuyet\n    + MaQuyetDinhThayThe nullable\n    --\n    + PheDuyet()\n    + ThayThe()\n}\n\n&#39; ================= LỚP CA LÀM &amp; CHẤM CÔNG =================\nclass KeHoachTuan {\n    + MaKeHoach\n    + MaPhongBan\n    + TuNgay\n    + DenNgay\n    + NguoiLap\n    + TrangThai\n    --\n    + ThemPhanCong()\n    + GuiDuyet()\n}\n\nclass CaLam {\n    + MaCa\n    + TenCa\n    + GioBatDau\n    + GioKetThuc\n    --\n    + TinhThoiLuongCa()\n}\n\nclass PhanCongCa {\n    + MaPhanCong\n    + MaKeHoach\n    + MaNhanVien\n    + MaCa\n    + NgayLam\n    + DuKienPhuTroi\n    --\n    + KiemTraTrungCa()\n}\n\nclass BangChamCong {\n    + MaChamCong\n    + MaNhanVien\n    + NgayCong\n    + MaCa\n    + GioVao\n    + GioRa\n    + SoGioCong\n    + TrangThai\n    + NguoiXacNhan\n    --\n    + TinhGioCong()\n    + XacNhan()\n}\n\nclass PhieuPhuTroi {\n    + MaPhieuPhuTroi\n    + NgayPhuTroi\n    + TongSoGio\n    + HinhThuc\n    + NguoiLap\n    + TrangThaiDuyet\n    --\n    + TinhTongGio()\n    + GuiDuyet()\n}\n\nclass ChiTietPhuTroi {\n    + MaChiTietPT\n    + MaPhieuPhuTroi\n    + MaNhanVien\n    + SoGio\n    + GioQuyDoi\n    --\n    + TinhGioQuyDoi()\n}\n\n&#39; ================= LỚP KHEN THƯỞNG, KỶ LUẬT &amp; TÀI CHÍNH =================\nclass QuyetDinhKhenThuong {\n    + MaQuyetDinhKT\n    + PhamVi\n    + LoaiKhenThuong\n    + MaNhanVien nullable\n    + MaPhongBan nullable\n    + LyDo\n    + SoTien\n    + NgayQuyetDinh\n    + NguoiLap\n    + NguoiKy\n    + TrangThaiDuyet\n    --\n    + GuiDuyet()\n    + PheDuyet()\n    + TaoChungTu()\n}\n\nclass QuyetDinhKyLuat {\n    + MaQuyetDinhKL\n    + PhamVi\n    + HinhThucKyLuat\n    + MaNhanVien nullable\n    + MaPhongBan nullable\n    + LyDo\n    + SoTien\n    + HinhThucThu\n    + NgayQuyetDinh\n    + NguoiLap\n    + NguoiKy\n    + TrangThaiDuyet\n    --\n    + GuiDuyet()\n    + PheDuyet()\n    + TaoChungTu()\n}\n\nclass PhieuThuChi {\n    + MaPhieuThuChi\n    + LoaiPhieu\n    + NgayLap\n    + SoTien\n    + NoiDung\n    + MaQuyetDinhKT nullable\n    + MaQuyetDinhKL nullable\n    + NguoiLap\n    + NguoiDuyet\n    + TrangThai\n    --\n    + PheDuyet()\n    + Huy()\n}\n\nclass DieuChinhLuong {\n    + MaDieuChinh\n    + MaNhanVien\n    + KyLuong\n    + LoaiDieuChinh\n    + SoTien\n    + MaQuyetDinhKL nullable\n    + TrangThai\n    --\n    + ApDung()\n    + Huy()\n}\n\n&#39; ================= LỚP BẢNG LƯƠNG &amp; BẢO HIỂM =================\nclass BangLuong {\n    + MaBangLuong\n    + Thang\n    + Nam\n    + NgayLap\n    + NguoiLap\n    + TrangThai\n    + TongLuong\n    + TongKhauTru\n    + TongThucLinh\n    --\n    + TinhToan()\n    + GuiDuyet()\n    + PheDuyet()\n}\n\nclass ChiTietBangLuong {\n    + MaChiTietLuong\n    + MaBangLuong\n    + MaNhanVien\n    + TongGioCong\n    + GioPhuTroiQuyDoi\n    + LuongCoBan\n    + PhuCap\n    + TienPhuTroi\n    + TienPhat\n    + BHXH\n    + BHYT\n    + KhauTruKhac\n    + ThucLinh\n    --\n    + TinhThucLinh()\n}\n\nclass TyLeBaoHiem {\n    + MaTyLeBH\n    + TuNgay\n    + DenNgay nullable\n    + TyLeBHXH_NV\n    + TyLeBHYT_NV\n    --\n    + LayTyLeTaiNgay()\n}\n\n&#39; ================= THIẾT LẬP HƯỚNG BỐ TRÍ MỐI QUAN HỆ =================\nPhongBan \&quot;1\&quot; -down- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;1\&quot; -left- \&quot;0..*\&quot; KeHoachTuan\nPhongBan \&quot;1\&quot; -right- \&quot;0..*\&quot; QuyetDinhTuyenDung\n\nNhanVien \&quot;0..1\&quot; -right- \&quot;0..1\&quot; TaiKhoan\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -left- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; HoSoBaoHiem\n\nHopDongLaoDong \&quot;1\&quot; -right- \&quot;0..1\&quot; HoSoBaoHiem\n\nQuyetDinhLuong \&quot;0..1\&quot; -up- \&quot;0..1\&quot; QuyetDinhLuong : thay thế\nQuyetDinhChucVu \&quot;0..1\&quot; -right- \&quot;0..1\&quot; QuyetDinhChucVu : thay thế\n\nKeHoachTuan \&quot;1\&quot; *-down- \&quot;1..*\&quot; PhanCongCa\nCaLam \&quot;1\&quot; -down- \&quot;0..*\&quot; PhanCongCa\nCaLam \&quot;1\&quot; -right- \&quot;0..*\&quot; BangChamCong\nNhanVien \&quot;1\&quot; -left- \&quot;0..*\&quot; PhanCongCa\nNhanVien \&quot;1\&quot; -left- \&quot;0..*\&quot; BangChamCong\n\nPhieuPhuTroi \&quot;1\&quot; *-right- \&quot;1..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; ChiTietPhuTroi\n\nPhongBan \&quot;0..1\&quot; -down- \&quot;0..*\&quot; QuyetDinhKhenThuong\nNhanVien \&quot;0..1\&quot; -down- \&quot;0..*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;0..1\&quot; -down- \&quot;0..*\&quot; QuyetDinhKyLuat\nNhanVien \&quot;0..1\&quot; -down- \&quot;0..*\&quot; QuyetDinhKyLuat\n\nQuyetDinhKhenThuong \&quot;0..1\&quot; -down- \&quot;0..*\&quot; PhieuThuChi\nQuyetDinhKyLuat \&quot;0..1\&quot; -down- \&quot;0..*\&quot; PhieuThuChi\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; DieuChinhLuong\nQuyetDinhKyLuat \&quot;0..1\&quot; -right- \&quot;0..*\&quot; DieuChinhLuong\n\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; ChiTietBangLuong\nBangLuong \&quot;1\&quot; *-right- \&quot;1..*\&quot; ChiTietBangLuong\nBangLuong .down.&gt; TyLeBaoHiem : &lt;&lt;use&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TH3-8h76nqIIDdPqln5D-986">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
