        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam sequenceMessageAlign center\n\nactor \&quot;Người lập\\n(Trưởng phòng / NS)\&quot; as NguoiLap\nparticipant \&quot;frmKhenThuong\\n(UI)\&quot; as UI\nparticipant \&quot;KhenThuongSvc\\n(Service)\&quot; as Svc\nparticipant \&quot;KhenThuongRepo\\n(Data)\&quot; as Repo\nactor \&quot;Giám đốc\&quot; as GD\nparticipant \&quot;ChungTuRepo\\n(PhieuThuChi)\&quot; as ChungTuRepo\n\nNguoiLap -&gt; UI : 1: nhập phạm vi, loại, lý do, số tiền\nactivate UI\n\nUI -&gt; Svc : 2: LapQuyetDinh(dto)\nactivate Svc\n\nSvc -&gt; Svc : 3: kiểm tra dữ liệu (BR11, BR15)\n\nalt PhamVi = Cá nhân\n    Svc -&gt; Repo : 4a: KiemTraNhanVien(MaNhanVien)\n    activate Repo\n    Repo --&gt; Svc : trả về NhanVien\n    deactivate Repo\nelse PhamVi = Phòng ban / tập thể\n    Svc -&gt; Repo : 4b: LayNhanVienTheoPhong(MaPhongBan)\n    activate Repo\n    Repo --&gt; Svc : trả về danh sách nhân viên\n    deactivate Repo\nend\n\nSvc -&gt; Repo : 5: Luu(QuyetDinhKhenThuong, TrangThaiDuyet = Chờ duyệt)\nactivate Repo\nRepo --&gt; Svc : MaQuyetDinhKT\ndeactivate Repo\n\nSvc --&gt; UI : 6: kết quả lập quyết định\ndeactivate Svc\n\nUI --&gt; NguoiLap : hiển thị quyết định\ndeactivate UI\n\nNguoiLap -&gt; UI : 7: GuiDuyet(MaQuyetDinhKT)\nactivate UI\n\nUI -&gt; Svc : 8: GuiDuyet()\nactivate Svc\n\nSvc -&gt; GD : 9: thông báo chờ phê duyệt\n\nGD -&gt; Svc : 10: PheDuyet(MaQuyetDinhKT) – giám đốc ký\n\nSvc -&gt; Repo : 11: CapNhatTrangThai(Đã duyệt, NguoiKy)\nactivate Repo\ndeactivate Repo\n\nSvc -&gt; ChungTuRepo : 12: TaoChungTu(MaQuyetDinhKT) -&gt; PhieuThuChi (phiếu chi khen thưởng)\nactivate ChungTuRepo\ndeactivate ChungTuRepo\n\nSvc --&gt; UI : 13: thông báo phê duyệt thành công\ndeactivate Svc\n\nUI --&gt; NguoiLap : hiển thị kết quả\ndeactivate UI\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TH3-8h76nqIIDdPqln5D-2163">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
