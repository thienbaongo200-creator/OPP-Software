        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; --- Cấu hình giao diện chuẩn Draw.io ---\nskinparam class {\n    BackgroundColor White\n    ArrowColor #2C3E50\n    BorderColor #2C3E50\n    HeaderBackgroundColor #EBF5FB\n}\nskinparam style strictuml\nhide empty members\n\n&#39; --- Định nghĩa các Class ---\nclass BenhNhan {\n    + maHoSo : String {PK}\n    + hoTen : String\n    + ngaySinh : Date\n    + diaChi : String\n    + dienThoai : String\n    + anh3x4 : String\n    + trangThaiHieuLuc : Boolean\n    --\n    + dangKyHoSo() : void\n    + capNhatThongTin() : void\n    + kiemTraHieuLuc() : Boolean\n}\n\nclass HoSoBenhAn {\n    + maHoSo : String {PK, FK}\n    + ngayLap : Date\n    + lePhiNam : Boolean\n    --\n    + taoTrangBia() : void\n    + xuatTrangBia() : void\n}\n\nclass PhieuKhamBenh {\n    + soPhieuKham : String {PK}\n    + maHoSo : String {FK}\n    + ngayGioKham : DateTime\n    + bacSiPhuTrach : String\n    + khoaDieuTri : String\n    + trieuChung : String\n    --\n    + taoPhieuKham() : void\n    + capNhatTrieuChung() : void\n}\n\nclass ChiTietXetNghiem {\n    + maChiDinh : String {PK}\n    + soPhieuKham : String {FK}\n    + loaiXetNghiem : String\n    + ketQua : String\n    --\n    + themChiDinh() : void\n    + capNhatKetQua() : void\n}\n\nclass ToaThuoc {\n    + maToa : String {PK}\n    + soPhieuKham : String {FK}\n    + tenThuoc : String\n    + soLuong : Integer\n    + lieuDung : String\n    --\n    + keToa() : void\n    + kiemTraTonKho() : Boolean\n}\n\nclass LichHenDinhKy {\n    + maLichHen : String {PK}\n    + maHoSo : String {FK}\n    + quy : Integer\n    + ngayGioHen : DateTime\n    + trangThai : String\n    --\n    + taoLichHen() : void\n    + nhacLichKham() : void\n}\n\n&#39; --- Mối quan hệ giữa các Class ---\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn : sở hữu &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;*\&quot; PhieuKhamBenh : chứa &gt;\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietXetNghiem : chỉ định &gt;\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;1\&quot; ToaThuoc : đi kèm &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;*\&quot; LichHenDinhKy : đăng ký &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BvmtX145a_yLxkJ2otaF-1">
