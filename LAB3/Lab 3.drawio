        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass KhachHang {\n  + string HoTen\n  + string CCCD\n  + string QuocTich\n  + string SoDienThoai\n  + string MaKhach {PK}\n}\n\nclass NhanVien {\n  + string HoTen\n  + string ChucVu\n  + string SoDienThoai\n  + string MaNV {PK}\n}\n\nclass LoaiTienNghi {\n  + string TenLoaiTN\n  + string MaLoaiTN {PK}\n}\n\nclass KhuVuc {\n  + string TenKhuVuc\n  + string MaKhuVuc {PK}\n  + DuyetDanhSachPhong()\n}\n\nclass TienNghi {\n  + string TenTienNghi\n  + string MaTienNghi {PK}\n  + string MaLoaiTN {FK}\n}\n\nclass Phong {\n  + string SoPhong\n  + int SucChuaToiDa\n  + decimal DonGia\n  + string MaPhong {PK}\n  + string MaKhuVuc {FK}\n  + KiemTraTrangThai()\n}\n\nclass DichVu {\n  + string TenDV\n  + decimal DonGia\n  + string MaDV {PK}\n}\n\nclass QuyDinhDenBu {\n  + string NoiDungHuHong\n  + decimal MucDenBu\n  + string MaQuyDinh {PK}\n}\n\nclass PhieuDatPhong {\n  + DateTime NgayNhanDuKien\n  + DateTime NgayTraDuKien\n  + decimal TienCoc\n  + string TrangThai\n  + string MaDatPhong {PK}\n  + string MaKhach {FK}\n  + string MaNV {FK}\n}\n\nclass HoaDon {\n  + DateTime NgayLapHD\n  + decimal TongTienPhong\n  + decimal TongTienDV\n  + decimal TongTienDenBu\n  + decimal ThanhTien\n  + string MaHD {PK}\n  + string MaDatPhong {FK}\n  + string MaNV {FK}\n  + TinhTien()\n}\n\nclass PhieuDenBu {\n  + decimal SoTienDenBu\n  + string MaPhieuDB {PK}\n  + string MaDatPhong {FK}\n  + string MaTienNghi {FK}\n  + string MaQuyDinh {FK}\n}\n\nclass PhieuLapDat {\n  + DateTime NgayLapDat\n  + string MaPhieuLD {PK}\n  + string MaPhong {FK}\n  + string MaTienNghi {FK}\n}\n\nclass ChiTietDatPhong {\n  + int SoNguoiO\n  + string MaDatPhong {PK, FK}\n  + string MaPhong {PK, FK}\n}\n\nclass NguoiLuuTru {\n  + string HoTen\n  + string CCCD\n  + string QuocTich\n  + int ID {PK}\n  + string MaDatPhong {FK}\n}\n\nclass ThanhToan {\n  + decimal SoTienThanhToan\n  + DateTime ThoiGian\n  + string MaThanhToan {PK}\n  + string MaHD {FK}\n  + string PhuongThuc (Tiền mặt/Chuyển khoản/Thẻ/Ví)\n}\n\nclass PhieuSuDungDichVu {\n  + DateTime NgaySuDung\n  + int SoLuong\n  + decimal ThanhTien\n  + string MaSDDV {PK}\n  + string MaDatPhong {FK}\n  + string MaDV {FK}\n  + CongDonDichVu()\n}\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDatPhong : đặt &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDatPhong : tiếp nhận &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : lập &gt;\nLoaiTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; TienNghi : phân loại &gt;\nKhuVuc \&quot;1\&quot; -- \&quot;0..*\&quot; Phong : chứa &gt;\nPhong \&quot;0..*\&quot; -- \&quot;0..*\&quot; TienNghi : được lắp đặt / quy định mức &gt;\nPhieuDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDatPhong : gồm &gt;\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDatPhong : được đặt &gt;\nPhieuDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuSuDungDichVu : sử dụng &gt;\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuSuDungDichVu : áp dụng &gt;\nPhieuDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NguoiLuuTru : danh sách người ở &gt;\nPhieuDatPhong \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon : thanh toán qua &gt;\nHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : giao dịch &gt;\nTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDenBu : bị hư hỏng / đền bù &gt;\nPhieuDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDenBu : sinh ra &gt;\nQuyDinhDenBu \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDenBu : áp dụng &gt;\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuLapDat : quy định / lắp đặt &gt;\nTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuLapDat : được lắp &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0u-V-w3fDWJOukIXOJbv-38">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
