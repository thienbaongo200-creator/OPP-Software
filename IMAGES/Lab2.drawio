        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass NhanVien {\n  + MaNhanVien: string {PK}\n  + Ho: string\n  + Ten: string\n  + Phai: string\n  + NgaySinh: DateTime\n  + ChucVu: string\n  + SoDienThoai: string\n}\n\nclass DocGia {\n  + MaDocGia: string {PK}\n  + Ho: string\n  + Ten: string\n  + NgaySinh: DateTime\n  + Phai: string\n  + SoDienThoai: string\n  + Diachi: string\n  + Email: string\n  + Anh3x4: string\n}\n\nclass TheDocGia {\n  + MaThe: string {PK}\n  + MaDocGia: string {FK}\n  + NgayCap: DateTime\n  + HanSuDung: DateTime\n  + DaDongLePhi: bool\n  + TrangThai: bool\n}\n\nclass TheLoai {\n  + MaTheLoai: string {PK}\n  + TenTheLoai: string\n}\n\nclass NhaXuatBan {\n  + MaNhaXuatBan: string {PK}\n  + Diachi: string\n  + SoDienThoai: string\n}\n\nclass DauSach {\n  + MaDauSach: string {PK}\n  + TenSach: string\n  + NamXuatBan: int\n  + SoLuongHienCo: int\n  + MaTheLoai: string {FK}\n  + MaNhaXuatBan: string {FK}\n}\n\nclass PhieuMuon {\n  + MaPhieuMuon: string {PK}\n  + MaDocGia: string {FK}\n  + MaNhanVien: string {FK}\n  + NgayMuon: DateTime\n  + NgayHenTra: DateTime\n}\n\nclass ChiTietPhieuMuon {\n  + MaChiTiet: string {PK}\n  + MaPhieuMuon: string {FK}\n  + MaDauSach: string {FK}\n  + NgayTraThucTe: DateTime\n  + TinhTrangTra: string\n}\n\nclass PhieuPhat {\n  + MaPhieuPhat: string {PK}\n  + MaChiTiet: string {FK}\n  + MaNhanVien: string {FK}\n  + NgayPhat: DateTime\n  + LyDo: string\n  + PhiPhat: decimal\n}\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; DauSach : lập &gt;\nTheLoai \&quot;1\&quot; -- \&quot;0..*\&quot; DauSach : lập &gt;\nNhaXuatBan \&quot;1\&quot; -- \&quot;0..*\&quot; DauSach : xuất bản &gt;\nDocGia \&quot;1\&quot; -- \&quot;1\&quot; TheDocGia : sở hữu lịch sử &gt;\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : thực hiện &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon : tiếp nhận / lập &gt;\nPhieuMuon \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuMuon : được mượn &gt;\nDauSach \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuMuon : thuộc &gt;\nChiTietPhieuMuon \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuPhat : sinh ra &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuPhat : lập &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cAqUnDpI3hwyu6AcgCAE-59">
