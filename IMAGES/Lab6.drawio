        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass BenhNhan {\n    + maBenhNhan : String {PK}\n    + hoTen : String\n    + ngaySinh : Date\n    + diaChi : String\n    + dienThoai : String\n    + anh3x4 : String\n    + dangKy() : void\n    + capNhatThongTin() : void\n}\n\nclass HoSoBenhAn {\n    + maHoSo : String {PK}\n    + maBenhNhan : String {FK}\n    + ngayLap : Date\n    + taoTrangBia() : void\n    + xuatTrangBia() : void\n    + kiemTraHieuLuc() : boolean\n}\n\nclass LePhiNam {\n    + maLePhi : String {PK}\n    + maHoSo : String {FK}\n    + nam : Integer\n    + soTien : Float\n    + ngayDong : Date\n    + thuLePhi() : void\n    + kiemTraDaDong() : boolean\n}\n\nclass BacSi {\n    + maBacSi : String {PK}\n    + hoTen : String\n    + chuyenMon : String\n    + maKhoa : String {FK}\n    + xemLichSuBenhAn() : void\n}\n\nclass Khoa {\n    + maKhoa : String {PK}\n    + tenKhoa : String\n    + themBacSi() : void\n}\n\nclass PhieuKhamBenh {\n    + soPhieuKham : String {PK}\n    + maHoSo : String {FK}\n    + maBacSi : String {FK}\n    + maKhoa : String {FK}\n    + ngayGioKham : DateTime\n    + loaiKham : String\n    + trieuChung : String\n    + nhietDo : Float\n    + huyetAp : String\n    + trangThai : String\n    + taoPhieuKham() : void\n    + capNhatTrieuChung() : void\n    + hoanTat() : void\n}\n\nclass LoaiXetNghiem {\n    + maLoaiXN : String {PK}\n    + tenLoaiXN : String\n}\n\nclass ChiTietXetNghiem {\n    + maChiDinh : String {PK}\n    + soPhieuKham : String {FK}\n    + maLoaiXN : String {FK}\n    + ketQua : String\n    + themChiDinh() : void\n    + capNhatKetQua() : void\n}\n\nclass ToaThuoc {\n    + maToa : String {PK}\n    + soPhieuKham : String {FK}\n    + ngayKe : Date\n    + phanUngPhu : String\n    + hieuQuaDieuTri : String\n    + keToa() : void\n    + inToa() : void\n}\n\nclass ChiTietToaThuoc {\n    + maChiTiet : String {PK}\n    + maToa : String {FK}\n    + maThuoc : String {FK}\n    + soLuong : Integer\n    + lieuDung : String\n    + themThuoc() : void\n    + xoaThuoc() : void\n}\n\nclass Thuoc {\n    + maThuoc : String {PK}\n    + tenThuoc : String\n    + donVi : String\n    + soLuongTon : Integer\n    + kiemTraTonKho() : boolean\n    + truTonKho() : void\n}\n\nclass LichHenDinhKy {\n    + maLichHen : String {PK}\n    + maHoSo : String {FK}\n    + nam : Integer\n    + quy : Integer\n    + ngayGioHen : DateTime\n    + trangThai : String\n    + taoLichHen() : void\n    + nhacLichKham() : void\n}\n\nclass ThanhToanVienPhi {\n    + maThanhToan : String {PK}\n    + soPhieuKham : String {FK}\n    + soTien : Float\n    + ngayThanhToan : Date\n    + ngayXuatVien : Date\n    + thanhToan() : void\n    + xacNhanXuatVien() : void\n}\n\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn : sở hữu &gt;\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;1..*\&quot; LePhiNam : đóng theo năm &gt;\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;*\&quot; PhieuKhamBenh : chứa &gt;\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;*\&quot; LichHenDinhKy : lịch hẹn &gt;\nBacSi \&quot;1\&quot; -- \&quot;*\&quot; PhieuKhamBenh : khám &gt;\nKhoa \&quot;1\&quot; -- \&quot;*\&quot; PhieuKhamBenh : điều trị &gt;\nKhoa \&quot;1\&quot; -- \&quot;*\&quot; BacSi : thuộc &gt;\nPhieuKhamBenh \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietXetNghiem : chỉ định &gt;\nLoaiXetNghiem \&quot;1\&quot; -- \&quot;*\&quot; ChiTietXetNghiem : định nghĩa &gt;\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc : kê toa &gt;\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc : gồm &gt;\nThuoc \&quot;1\&quot; -- \&quot;*\&quot; ChiTietToaThuoc : thuốc trong toa &gt;\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; ThanhToanVienPhi : thanh toán &gt;\nLichHenDinhKy \&quot;0..1\&quot; ..&gt; \&quot;0..1\&quot; PhieuKhamBenh : sinh ra &gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="m6p9LCJoLooSzuwCUwwe-1">
