        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;Bác sĩ\&quot; as BS\nparticipant \&quot;FrmPhieuKham\&quot; as UI\nparticipant \&quot;PhieuKhamController\&quot; as Ctrl\ndatabase \&quot;SQL Server\&quot; as DB\n\nBS -&gt; UI: Mở phiếu khám đang khám, chọn \&quot;Kê toa thuốc\&quot;\nUI -&gt; Ctrl: layDanhSachThuoc()\nCtrl -&gt; DB: SELECT Thuoc WHERE soLuongTon &gt; 0\nDB --&gt; Ctrl: Danh sách thuốc\nCtrl --&gt; UI: Trả danh sách thuốc\nUI --&gt; BS: Hiển thị form nhập toa\n\nloop mỗi thuốc trong toa\n    BS -&gt; UI: Chọn thuốc, nhập số lượng, liều dùng\n    UI -&gt; Ctrl: kiemTraTonKho(maThuoc, soLuong)\n    Ctrl --&gt; UI: Hợp lệ / \&quot;Không đủ tồn\&quot;\n    UI --&gt; BS: Thêm dòng vào toa (hoặc báo lỗi)\nend\n\nBS -&gt; UI: Nhập phản ứng phụ (nếu có), bấm \&quot;Lưu toa\&quot;\nUI -&gt; Ctrl: keToa(soPhieuKham, dsChiTiet, phanUngPhu)\nCtrl -&gt; DB: EXEC sp_KeToaThuoc (BEGIN TRAN)\nDB -&gt; DB: Kiểm tra phiếu \&quot;Đang khám\&quot; &amp; chưa có toa;\\nINSERT ToaThuoc, ChiTietToaThuoc;\\nUPDATE Thuoc (trừ tồn)\n\nalt thành công\n    DB --&gt; Ctrl: COMMIT, trả maToa\n    Ctrl --&gt; UI: KetQuaXuLy.Ok(maToa)\n    UI --&gt; BS: \&quot;Kê toa thành công\&quot;, cho phép in toa\nelse lỗi: hết thuốc / phiếu đã hoàn tất\n    DB --&gt; Ctrl: ROLLBACK, trả mã lỗi\n    Ctrl --&gt; UI: KetQuaXuLy.Loi(thongBao)\n    UI --&gt; BS: MessageBox cảnh báo\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5vcuBI3Nm6e9lVolNC59-198">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
