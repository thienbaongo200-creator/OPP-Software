        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Nhân viên CSKH /\\nThu ngân\&quot; as NV\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ\&quot; as BS\n\nrectangle \&quot;Phân rã: Đăng ký khám → xét nghiệm → nhận toa thuốc\&quot; {\n    usecase \&quot;UC01: Đăng ký và cấp hồ sơ bệnh án\&quot; as UC01\n    usecase \&quot;Nhập thông tin cá nhân &amp; ảnh 3x4\&quot; as UC01_1\n    usecase \&quot;Thu lệ phí năm\&quot; as UC01_2\n    usecase \&quot;Cấp mã hồ sơ bệnh án\&quot; as UC01_3\n\n    usecase \&quot;UC02: Tra cứu hồ sơ bệnh án\&quot; as UC02\n\n    usecase \&quot;UC03: Lập phiếu khám bệnh\&quot; as UC03\n    usecase \&quot;Kiểm tra hiệu lực hồ sơ\&quot; as UC03_1\n    usecase \&quot;Ghi nhận triệu chứng\&quot; as UC03_2\n\n    usecase \&quot;UC04: Chỉ định xét nghiệm\&quot; as UC04\n    usecase \&quot;Cập nhật kết quả xét nghiệm\&quot; as UC04_1\n\n    usecase \&quot;UC05: Kê toa thuốc\&quot; as UC05\n    usecase \&quot;Kiểm tra tồn kho thuốc\&quot; as UC05_1\n    usecase \&quot;Lưu toa &amp; in toa thuốc\&quot; as UC05_2\n\n    usecase \&quot;Nhận toa thuốc\&quot; as UC_NhanToa\n\n    NV -- UC01\n    BN -- UC01\n    BN -- UC02\n    BN -- UC03\n    BN -- UC04\n    BN -- UC05\n    BS -- UC03\n    BS -- UC04\n    BS -- UC05\n    BS -- UC_NhanToa\n    BN -- UC_NhanToa\n\n    UC01 ..&gt; UC01_1 : &lt;&lt;include&gt;&gt;\n    UC01 ..&gt; UC01_2 : &lt;&lt;include&gt;&gt;\n    UC01 ..&gt; UC01_3 : &lt;&lt;include&gt;&gt;\n\n    UC03 ..&gt; UC03_1 : &lt;&lt;include&gt;&gt;\n    UC03 ..&gt; UC03_2 : &lt;&lt;include&gt;&gt;\n\n    UC04 ..&gt; UC04_1 : &lt;&lt;include&gt;&gt;\n    UC04 .up.&gt; UC03 : &lt;&lt;extend&gt;&gt;\n\n    UC05 ..&gt; UC05_1 : &lt;&lt;include&gt;&gt;\n    UC05 ..&gt; UC05_2 : &lt;&lt;include&gt;&gt;\n    UC05 .up.&gt; UC03 : &lt;&lt;extend&gt;&gt;\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5vcuBI3Nm6e9lVolNC59-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 10 10 250;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
