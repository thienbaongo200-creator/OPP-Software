        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam DefaultTextAlignment center\n\n|KHÁCH HÀNG|\n|HỆ THỐNG|\n|DỊCH VỤ THANH TOÁN|\n\n|KHÁCH HÀNG|\nstart\n:Chọn Thanh toán;\n\nif (Đã đăng nhập?) then (Chưa)\n  :Màn hình Đăng ký / Đăng nhập;\n  :Đăng nhập thành công;\nelse (Đã đăng nhập)\nendif\n\n:Chọn hình thức giao hàng;\n:Nhập thông tin người nhận;\n\n|HỆ THỐNG|\npartition \&quot;Tính Phí Giao Hàng\&quot; {\n  if (Đơn hàng &gt;= 5.000.000đ?) then (Có)\n    :Miễn phí giao hàng trong ngày;\n  else (Non)\n    if (Đơn hàng &gt;= 1.000.000đ\\nAND chọn CPN?) then (Có)\n      :Miễn phí giao hàng nhanh;\n    else (Không)\n      :Tính phí theo bảng DeliveryFee;\n    endif\n  endif\n  :Cộng phí giao hàng vào tổng đơn;\n}\n\n|KHÁCH HÀNG|\n:Nhập thông tin thẻ tín dụng;\n\n|HỆ THỐNG|\n:Gửi yêu cầu xác thực;\n\n|DỊCH VỤ THANH TOÁN|\n:Xác thực thông tin thẻ;\n\nif (Thanh toán thành công?) then (Thành công)\n  |HỆ THỐNG|\n  :Ghi nhận đơn hàng vào CSDL;\n  \n  if (Khách hàng có Email?) then (Có)\n    :Gửi email xác nhận thành công;\n  else (Không)\n  endif\n  \n  |KHÁCH HÀNG|\n  :Hiển thị mã đơn hàng thành công;\n  stop\nelse (Thất bại)\n  |KHÁCH HÀNG|\n  :Hiển thị thông báo thanh toán thất bại;\n  stop\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KpXnE32iBW5P1934K5rS-161">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
