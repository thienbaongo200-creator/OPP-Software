        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Khách hàng\&quot; as KhachHang\nparticipant \&quot;FrmCheckout\\n(Boundary)\&quot; as Frm\nparticipant \&quot;CheckoutService\\n(Controller)\&quot; as Service\nparticipant \&quot;PaymentAdapter\&quot; as PaymentAdapter\nparticipant \&quot;Dịch vụ thanh toán\\ntrực tuyến\&quot; as ExtPayment\nparticipant \&quot;OrderService\&quot; as OrderService\ndatabase \&quot;SQL Server\\n(CSDL)\&quot; as DB\nparticipant \&quot;EmailAdapter\&quot; as EmailAdapter\nparticipant \&quot;Dịch vụ Email\&quot; as ExtEmail\n\nKhachHang -&gt; Frm: Chọn thanh toán\nKhachHang -&gt; Frm: Nhập thông tin người nhận, loại giao hàng, thông tin thẻ\nFrm -&gt; Service: submitCheckout(data)\nService -&gt; Service: Tính tiền hàng, phí giao &amp; tổng tiền\nService -&gt; PaymentAdapter: pay(paymentData, amount)\nPaymentAdapter -&gt; ExtPayment: Gửi yêu cầu thanh toán\n\nalt Thanh toán thành công\n    ExtPayment --&gt; PaymentAdapter: PaymentSuccess(reference)\n    PaymentAdapter --&gt; Service: Thanh toán thành công\n    Service -&gt; OrderService: createOrder(orderData)\n    OrderService -&gt; DB: INSERT Orders, OrderItem, Payment\n    DB --&gt; OrderService: Lưu thành công\n    OrderService --&gt; Service: Trả về OrderID\n\n    opt Khách hàng có email\n        Service -&gt; EmailAdapter: sendConfirmation(order)\n        EmailAdapter -&gt; ExtEmail: Gửi email xác nhận\n        ExtEmail --&gt; EmailAdapter: Đã gửi thành công\n        EmailAdapter --&gt; Service: Gửi thành công\n    end\n\n    Service --&gt; Frm: Đặt hàng thành công + OrderID\n    Frm --&gt; KhachHang: Hiển thị kết quả thành công\n\nelse Thanh toán thất bại\n    ExtPayment --&gt; PaymentAdapter: PaymentFailed(error)\n    PaymentAdapter --&gt; Service: Thanh toán thất bại\n    Service --&gt; Frm: Trả lỗi thanh toán\n    Frm --&gt; KhachHang: Hiển thị thông báo lỗi\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5GS4a9QmDPw-b4D_xE8S-145">
