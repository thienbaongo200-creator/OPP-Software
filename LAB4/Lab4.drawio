        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam RoundCorner 8\nskinparam Shadowing false\nskinparam Monochrome false\n\nskinparam rectangle {\n    BackgroundColor #FFFFFF\n    BorderColor #333333\n    BorderThickness 1.5\n    FontSize 13\n}\n\nrectangle \&quot;Hệ thống e-SHOPPING\&quot; as Root\n\n&#39; --- Cấp 1 ---\nrectangle \&quot;1. Quản lý Khách hàng\&quot; as CM\nrectangle \&quot;2. Tra cứu Sản phẩm\&quot; as PS\nrectangle \&quot;3. Quản lý Giỏ hàng\&quot; as Cart\nrectangle \&quot;4. Thanh toán &amp; Đặt hàng\&quot; as Pay\nrectangle \&quot;5. Xác nhận &amp; Thông báo\&quot; as Noti\n\nRoot --&gt; CM\nRoot --&gt; PS\nRoot --&gt; Cart\nRoot --&gt; Pay\nRoot --&gt; Noti\n\n&#39; --- Cấp 2 ---\nrectangle \&quot;Đăng ký tài khoản\&quot; as CM1\nrectangle \&quot;Đăng nhập hệ thống\&quot; as CM2\nCM --&gt; CM1\nCM --&gt; CM2\n\nrectangle \&quot;Chọn nhóm sản phẩm\&quot; as PS1\nrectangle \&quot;Xem chi tiết sản phẩm\&quot; as PS2\nrectangle \&quot;Đọc dữ liệu từ HT QLSP\&quot; as PS3\nPS --&gt; PS1\nPS --&gt; PS2\nPS --&gt; PS3\n\nrectangle \&quot;Thêm sản phẩm vào giỏ\&quot; as Cart1\nrectangle \&quot;Cập nhật số lượng\&quot; as Cart2\nrectangle \&quot;Xóa sản phẩm khỏi giỏ\&quot; as Cart3\nCart --&gt; Cart1\nCart --&gt; Cart2\nCart --&gt; Cart3\n\nrectangle \&quot;Chọn loại hình giao hàng\&quot; as Pay1\nrectangle \&quot;Nhập thông tin người nhận\&quot; as Pay2\nrectangle \&quot;Tính phí giao hàng\&quot; as Pay3\nrectangle \&quot;Xác thực thanh toán thẻ\&quot; as Pay4\nrectangle \&quot;Ghi nhận đơn hàng\&quot; as Pay5\nPay --&gt; Pay1\nPay --&gt; Pay2\nPay --&gt; Pay3\nPay --&gt; Pay4\nPay --&gt; Pay5\n\nrectangle \&quot;Gửi email xác nhận đơn hàng\&quot; as Noti1\nNoti --&gt; Noti1\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5GS4a9QmDPw-b4D_xE8S-428">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
