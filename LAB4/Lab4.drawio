        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as Customer\n\nactor \&quot;Hệ thống quản lý\\nsản phẩm\&quot; as ProductSystem\nactor \&quot;Dịch vụ thanh toán\\ntrực tuyến\&quot; as PaymentService\nactor \&quot;Dịch vụ Email\&quot; as EmailService\n\nrectangle \&quot;Hệ thống e-SHOPPING\&quot; {\n\n    usecase \&quot;Tra cứu sản phẩm\&quot; as UC1\n    usecase \&quot;Xem chi tiết\\nsản phẩm\&quot; as UC2\n    usecase \&quot;Quản lý giỏ hàng\&quot; as UC3\n\n    usecase \&quot;Đăng ký tài khoản\&quot; as UC4\n    usecase \&quot;Đăng nhập hệ thống\&quot; as UC5\n\n    usecase \&quot;Đặt hàng / Thanh toán\&quot; as UC6\n\n    usecase \&quot;Chọn hình thức\\ngiao hàng\&quot; as UC7\n    usecase \&quot;Nhập thông tin\\nngười nhận\&quot; as UC8\n    usecase \&quot;Nhập thông tin\\nthanh toán\&quot; as UC9\n\n    usecase \&quot;Xác thực\\nthanh toán\&quot; as UC10\n\n    usecase \&quot;Ghi nhận\\nđơn hàng\&quot; as UC11\n\n    usecase \&quot;Gửi Email\\nxác nhận\&quot; as UC12\n\n    usecase \&quot;Lấy thông tin\\nsản phẩm\&quot; as UC13\n}\n\nCustomer --&gt; UC1\nCustomer --&gt; UC2\nCustomer --&gt; UC3\nCustomer --&gt; UC4\nCustomer --&gt; UC5\nCustomer --&gt; UC6\n\nUC1 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC2 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\n\nUC6 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\nUC12 ..&gt; UC11 : &lt;&lt;extend&gt;&gt;\n\nProductSystem --&gt; UC13\nPaymentService --&gt; UC10\nEmailService --&gt; UC12\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5zPMVUZQlw_5xldEIsVn-1">
