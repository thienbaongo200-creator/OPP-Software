        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\n\nentity Tang {\n    * MaTang : VARCHAR(12)\n    --\n    TenTang : NVARCHAR(50)\n    MoTa : NVARCHAR(255)\n    TrangThai : NVARCHAR(20)\n}\n\nentity Phong {\n    * MaPhong : VARCHAR(12)\n    --\n    MaTang : FK\n    MaPhongHienThi\n    DienTich\n    Huong\n    DonGiaThang\n    TrangThai\n}\n\nentity KhachHang {\n    * MaKhachHang : VARCHAR(12)\n    --\n    TenKhachHang\n    LoaiKhachHang\n    MaSoThue\n    DienThoai\n    Email\n    DiaChi\n}\n\nentity HopDongThue {\n    * MaHopDong : VARCHAR(12)\n    --\n    MaKhachHang : FK\n    NgayKy\n    NgayBatDau\n    NgayKetThuc\n    TrangThai\n    ThoiHanBanDauThang\n}\n\nentity ChiTietHopDong {\n    * MaChiTietHD : VARCHAR(12)\n    --\n    MaHopDong : FK\n    MaPhong : FK\n    DonGiaThoaThuan\n    NgayBatDau\n    NgayKetThuc\n    ThoiHanBanDauThang\n}\n\nentity PhieuGiaHan {\n    * MaPhieuGiaHan : VARCHAR(12)\n    --\n    MaHopDong : FK\n    MaChiTietHD : FK\n    NgayLap\n    ThoiGianGiaHanThang\n    NgayKetThucCu\n    NgayKetThucMoi\n    TrangThai\n}\n\nentity ThanhToan {\n    * MaThanhToan : VARCHAR(12)\n    --\n    MaHopDong : FK\n    MaChiTietHD : FK\n    MaKy : FK\n    LoaiThanhToan\n    SoTien\n    NgayThanhToan\n}\n\nentity KyThanhToanTienThue {\n    * MaKy : VARCHAR(16)\n    --\n    MaHopDong : FK\n    MaChiTietHD : FK\n    ThangNam\n    SoTien\n    HanThanhToan\n    TrangThai\n}\n\nentity DichVu {\n    * MaDichVu : VARCHAR(12)\n    --\n    TenDichVu\n    DonGia\n    DonViTinh\n}\n\nentity ChiTietSuDungDichVu {\n    * MaSuDung : VARCHAR(12)\n    --\n    MaHopDong : FK\n    MaPhong : FK\n    MaDichVu : FK\n    KyThang\n    SoLuong\n    DonGiaApDung\n}\n\nentity HoaDonDichVu {\n    * MaHoaDonDV : VARCHAR(12)\n    --\n    MaHopDong : FK\n    KyThang\n    TongTien\n    TrangThai\n}\n\nentity ChiTietHoaDonDV {\n    * MaCTHoaDon : VARCHAR(12)\n    --\n    MaHoaDonDV : FK\n    MaSuDung : FK\n    Than