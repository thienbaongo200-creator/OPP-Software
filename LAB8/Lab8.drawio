        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\nclass KhachHang {\n  + MaKhachHang (PK)\n  + TenKhachHang\n  + LoaiKhachHang\n  + MaSoThue\n  + DienThoai\n  + Email\n  + DiaChi\n  --\n  + CapNhatThongTin()\n  + XemHopDong()\n}\n\nclass Tang {\n  + MaTang (PK)\n  + TenTang\n  + MoTa\n  + TrangThai\n  --\n  + Them()\n  + CapNhat()\n  + DanhSachPhong()\n}\n\nclass Phong {\n  + MaPhong (PK)\n  + MaTang (FK)\n  + MaPhongHienThi\n  + DienTich\n  + Huong\n  + DonGiaThang\n  + TrangThai\n  --\n  + TinhTienThue()\n  + KiemTraTrong()\n}\n\nclass HopDongThue {\n  + MaHopDong (PK)\n  + MaKhachHang (FK)\n  + NgayKy\n  + NgayBatDau / NgayKetThuc\n  + ThoiHanBanDauThang\n  + TrangThai\n  --\n  + KiemTraThoiHan()\n  + TinhTien6ThangDau()\n  + KiemTraCongNo()\n}\n\nclass ChiTietHopDong {\n  + MaChiTietHD (PK)\n  + MaHopDong (FK)\n  + MaPhong (FK)\n  + DonGiaThoaThuan\n  + NgayBatDau / NgayKetThuc\n  + ThoiHanBanDauThang\n  --\n  + TinhTienTheoKy()\n  + KiemTraTrungLich()\n}\n\nclass PhieuGiaHan {\n  + MaPhieuGiaHan (PK)\n  + MaHopDong (FK)\n  + MaChiTietHD (FK, NULL)\n  + ThoiGianGiaHanThang\n  + NgayKetThucCu / Moi\n  + TrangThai\n  --\n  + KiemTraDieuKien()\n  + TinhNgayKetThucMoi()\n  + XacNhan()\n}\n\nclass KyThangToanTienThue {\n  + MaKy (PK)\n  + MaHopDong (FK)\n  + MaChiTietHD (FK, NULL)\n  + ThangNam\n  + SoTien\n  + HanThanhToan\n  + TrangThai\n}\n\nclass ThanhToan {\n  + MaThanhToan (PK)\n  + MaHopDong (FK)\n  + MaChiTietHD (FK, NULL)\n  + MaKy (FK, NULL)\n  + LoaiThanhToan\n  + NgayThanhToan\n  + SoTien\n  + PhuongThuc\n}\n\nclass LichSuGiaPhong {\n  + MaLichSuGia (PK)\n  + MaPhong (FK)\n  + DonGia\n  + TuNgay / DenNgay\n}\n\n&#39; Mối quan hệ\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongThue : 1 : N\nTang \&quot;1\&quot; -- \&quot;0..*\&quot; Phong : 1 : N\nHopDongThue \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHopDong : 1 : 1..N\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong : 1 : N\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuGiaPhong : 1 : N\n\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan : 1 : N\nChiTietHopDong \&quot;0..1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan : 0..1 : N\n\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; KyThangToanTienThue : 1 : N\nChiTietHopDong \&quot;0..1\&quot; -- \&quot;0..*\&quot; KyThangToanTienThue : 0..1 : N\n\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : 1 : N\nChiTietHopDong \&quot;0..1\&quot; -- \&quot;0..*\&quot; ThanhToan : 0..1 : N\nKyThangToanTienThue \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : 1 : 0..N\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DJz1WVmxz6VpR6GXy15k-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
