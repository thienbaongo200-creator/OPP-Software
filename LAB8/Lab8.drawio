        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\nclass NhanVienQuanLy {\n  + MaNhanVienQL (PK)\n  + HoTen\n  + ChucVu\n  + DienThoai\n  + TrangThai\n}\n\nclass TaiKhoan {\n  + MaTaiKhoan (PK)\n  + TenDangNhap\n  + MatKhauHash\n  + VaiTro\n  + TrangThai\n  + MaNhanVienQL (FK, NULL, UNIQUE)\n  --\n  + DangNhap()\n  + KiemTraQuyen()\n}\n\nclass KhachHang {\n  + MaKhachHang (PK)\n  + LoaiKhachHang = DoanhNghiep\n}\n\nclass Phong {\n  + MaPhong (PK)\n}\n\nclass NhanVienVanPhong {\n  + MaNhanVienVP (PK)\n  + MaKhachHang (FK)\n  + MaPhong (FK)\n  + HoTen\n  + ChucVu\n  + DienThoai\n  + TrangThai\n  --\n  + CapNhatHoSo()\n  + ChuyenPhong()\n}\n\nclass TheGiuXe {\n  + MaThe (PK)\n  + MaNhanVienVP (FK)\n  + BienSoXe\n  + LoaiXe\n  + MauXe\n  + NgayCap\n  + NgayHetHan\n  + TrangThai\n  --\n  + CapThe()\n  + ThuHoiThe()\n}\n\nclass BienBanKiemTra {\n  + MaBienBan (PK)\n  + MaPhong (FK)\n  + NgayKiemTra\n  + NguoiKiemTra\n  + TinhTrang\n  + GhiChu\n  --\n  + LapBienBan()\n  + GhiNhanViPham()\n}\n\nclass ViPham {\n  + MaViPham (PK)\n  + MaBienBan (FK)\n  + MoTa\n  + MucPhat\n  + TrangThaiXuLy\n}\n\n&#39; Mối quan hệ giữa các lớp\nNhanVienQuanLy \&quot;1\&quot; --&gt; \&quot;0..1\&quot; TaiKhoan : 1 : 0..1\nKhachHang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; NhanVienVanPhong : 1 : N (chi DoanhNghiep)\nPhong \&quot;1\&quot; --&gt; \&quot;0..*\&quot; NhanVienVanPhong : 1 : N\nNhanVienVanPhong \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TheGiuXe : 1 : N\nPhong \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BienBanKiemTra : 1 : N\nBienBanKiemTra \&quot;1\&quot; --* \&quot;0..*\&quot; ViPham : 1 : 0..N\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DJz1WVmxz6VpR6GXy15k-489">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
