        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Nhân viên quản lý\&quot; as NVQL\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Kế toán\&quot; as KT\n\nrectangle \&quot;Quy trình: ký hợp đồng -&gt; thanh toán -&gt; dịch vụ\&quot; {\n  &#39; === NHÓM CHÍNH BÊN TRÁI (Tác nhân tương tác trực tiếp) ===\n  usecase \&quot;Lập và ký hợp đồng thuê\&quot; as UCD03\n  usecase \&quot;Ghi nhận thanh toán trước 6 tháng\&quot; as UCD05\n  usecase \&quot;Thanh toán tiền thuê tháng hiện tại\&quot; as UCD07\n  usecase \&quot;Lập hóa đơn dịch vụ tháng\&quot; as UCD09\n  usecase \&quot;Thanh toán hóa đơn dịch vụ\&quot; as UCD10\n  usecase \&quot;Tra cứu công nợ\&quot; as UCD11\n\n  &#39; === NHÓM CHI TIẾT BÊN PHẢI (Các bước con / bao hàm) ===\n  usecase \&quot;Chọn khách hàng và phòng\&quot; as UCD01\n  usecase \&quot;Kiểm tra phòng còn trống\&quot; as UCD02\n  usecase \&quot;Tính tiền thuê 6 tháng đầu\&quot; as UCD04\n  usecase \&quot;Ghi nhận chỉ số/sử dụng dịch vụ\&quot; as UCD08\n\n  &#39; === QUAN HỆ INCLUDE &amp; EXTEND ===\n  UCD03 ..&gt; UCD02 : &lt;&lt;include&gt;&gt;\n  UCD03 ..&gt; UCD01 : &lt;&lt;include&gt;&gt;\n  UCD03 ..&gt; UCD04 : &lt;&lt;include&gt;&gt;\n  \n  UCD05 ..&gt; UCD04 : &lt;&lt;include&gt;&gt;\n  UCD09 ..&gt; UCD08 : &lt;&lt;include&gt;&gt;\n  \n  UCD11 ..&gt; UCD07 : &lt;&lt;extend&gt;&gt;\\n[còn nợ tiền thuê]\n  UCD11 ..&gt; UCD10 : &lt;&lt;extend&gt;&gt;\\n[còn nợ dịch vụ]\n}\n\n&#39; === LIÊN KẾT TÁC NHÂN VỚI HỆ THỐNG ===\nNVQL --&gt; UCD03\nNVQL --&gt; UCD09\nNVQL --&gt; UCD11\n\nKH --&gt; UCD03\nKH --&gt; UCD07\nKH --&gt; UCD10\n\nKT --&gt; UCD05\nKT --&gt; UCD07\nKT --&gt; UCD10\nKT --&gt; UCD11\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zZ5CfLfWDwPN1SqNu9HP-164">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 10 153 10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
